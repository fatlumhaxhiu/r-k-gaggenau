generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  full_name     String?   @db.VarChar(255)
  role          String?   @default("admin") @db.VarChar(50)
  avatar_url    String?   @db.Text
  last_login_at DateTime? @db.Timestamptz
  created_at    DateTime? @default(now()) @db.Timestamptz
  updated_at    DateTime? @default(now()) @db.Timestamptz

  leads      Lead[]
  blog_posts BlogPost[]
  sessions   Session[]

  @@map("admins")
}

model Session {
  id         String   @id @db.Uuid
  admin_id   String   @db.Uuid
  token      String   @unique @db.Text
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  admin Admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Lead {
  request_id        String?   @unique @db.Uuid
  request_hash      String?   @db.VarChar(64)
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name         String?   @db.VarChar(255)
  object_type       String?   @db.VarChar(100)
  first_name        String    @db.VarChar(100)
  last_name         String    @db.VarChar(100)
  email             String    @db.VarChar(255)
  phone             String?   @db.VarChar(50)
  city              String?   @db.VarChar(100)
  service_requested String?   @db.VarChar(100)
  source_page       String?   @db.VarChar(255)
  marketing_channel String?   @db.VarChar(50)
  campaign_name     String?   @db.VarChar(255)
  message           String?   @db.Text
  status            String?   @default("new") @db.VarChar(50)
  assigned_to       String?   @db.Uuid
  notes             String?   @db.Text
  lead_score        Int?      @default(0)
  responded_at      DateTime? @db.Timestamptz
  converted_at      DateTime? @db.Timestamptz
  closed_at         DateTime? @db.Timestamptz
  closure_reason    String?   @db.VarChar(500)
  retention_hold_reason String? @db.VarChar(500)
  retention_review_at DateTime? @db.Timestamptz
  created_at        DateTime? @default(now()) @db.Timestamptz
  updated_at        DateTime? @default(now()) @db.Timestamptz

  assigned_admin Admin? @relation(fields: [assigned_to], references: [id])

  @@map("leads")
}

model BlogPost {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String    @db.VarChar(500)
  slug            String    @unique @db.VarChar(500)
  excerpt         String?   @db.Text
  content         String?   @db.Text
  cover_image_url String?   @db.Text
  category        String?   @db.VarChar(100)
  status          String?   @default("draft") @db.VarChar(50)
  author_id       String?   @db.Uuid
  views_count     Int?      @default(0)
  published_at    DateTime? @db.Timestamptz
  created_at      DateTime? @default(now()) @db.Timestamptz
  updated_at      DateTime? @default(now()) @db.Timestamptz

  author Admin? @relation(fields: [author_id], references: [id])

  @@map("blog_posts")
}

model ContactSubmission {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(255)
  email      String    @db.VarChar(255)
  phone      String?   @db.VarChar(50)
  subject    String?   @db.VarChar(500)
  message    String    @db.Text
  is_read    Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz

  @@map("contact_submissions")
}

// Transient, consented delivery payloads are cleared on acknowledgment, expiry or withdrawal.
model TrackingDelivery {
  event_id         String    @id @db.VarChar(64)
  session_id       String    @db.Uuid
  event_name       String    @db.VarChar(32)
  payload          Json?     @db.JsonB
  consent_version  Int
  consent_saved_at DateTime  @db.Timestamptz
  status           String    @default("pending") @db.VarChar(16)
  attempts         Int       @default(0)
  next_attempt_at  DateTime  @default(now()) @db.Timestamptz
  locked_until     DateTime? @db.Timestamptz
  last_error       String?   @db.VarChar(100)
  sent_at          DateTime? @db.Timestamptz
  created_at       DateTime  @default(now()) @db.Timestamptz

  @@index([status, next_attempt_at, locked_until])
  @@index([session_id, status])
  @@map("tracking_deliveries")
}

// Minute buckets contain only opaque hashes; the worker expires them automatically.
model TrackingRateLimit {
  key        String   @id @db.VarChar(64)
  count      Int      @default(1)
  expires_at DateTime @db.Timestamptz

  @@index([expires_at])
  @@map("tracking_rate_limits")
}